local API_BASE = "https://thegoat.shardweb.app"

-- ============================================
-- WHITELIST CHECK: verify if player is whitelisted
-- ============================================
do
  local checkUrl = API_BASE .. "/api/whitelist-check?player=" .. HttpService:UrlEncode(player.Name) .. "&pid=" .. tostring(player.UserId)
  local ok, res = pcall(function()
    return game:HttpGet(checkUrl)
  end)

  if ok and res then
    local parseOk, data = pcall(function()
      return HttpService:JSONDecode(res)
    end)

    if parseOk and type(data) == "table" then
      if data.whitelisted then
        -- Player is whitelisted — execute script directly
        pcall(function()
          game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "TheGoat",
            Text = "Welcome! Loading...",
            Duration = 3
          })
        end)

        local execUrl = API_BASE .. "/api/whitelist-exec?player=" .. HttpService:UrlEncode(player.Name) .. "&pid=" .. tostring(player.UserId)
        local scriptOk, scriptCode = pcall(function()
          return game:HttpGet(execUrl)
        end)

        if scriptOk and scriptCode and scriptCode ~= "" then
          pcall(function() loadstring(scriptCode)() end)
          task.wait(0.5)
          pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
              Title = "TheGoat",
              Text = "Script loaded!",
              Duration = 3
            })
          end)
          return
        else
          -- Script fetch failed
          pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
              Title = "TheGoat",
              Text = "Error loading script. Try again.",
              Duration = 5
            })
          end)
          return
        end
      else
        -- Not whitelisted — show panel asking to request access
        -- Fall through to panel below
      end
    end
  end
end

